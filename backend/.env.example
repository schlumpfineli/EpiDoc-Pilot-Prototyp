# =============================================================================
# EpiDoc Backend - Umgebungsvariablen Template
# =============================================================================
# Kopiere diese Datei zu .env und fülle die Werte aus
# cp .env.example .env
# php artisan key:generate
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME="EpiDoc"
APP_ENV=local
# Generiere APP_KEY mit: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# =============================================================================
# Database Configuration
# =============================================================================
# Für SQLite (Standard für Entwicklung)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Für MySQL/PostgreSQL (Produktion) - auskommentieren SQLite-Zeilen oben
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=epidoc
# DB_USERNAME=root
# DB_PASSWORD=

# Für PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=epidoc
# DB_USERNAME=postgres
# DB_PASSWORD=

DB_FOREIGN_KEYS=true

# =============================================================================
# Broadcasting
# =============================================================================
BROADCAST_CONNECTION=log

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_STORE=file
# Für bessere Performance in Produktion: Redis verwenden
# CACHE_STORE=redis

# =============================================================================
# Filesystem Configuration
# =============================================================================
FILESYSTEM_DISK=local
# Für Produktion: S3 oder ähnliche Cloud-Storage-Lösungen
# FILESYSTEM_DISK=s3

# =============================================================================
# Queue Configuration
# =============================================================================
# Für Development: sync (synchron, keine Queue)
QUEUE_CONNECTION=sync
# Für Produktion: database oder redis
# QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Mail Configuration
# =============================================================================
# Für Development: Log-Driver (E-Mails werden in storage/logs/laravel.log geschrieben)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=null

# Für Development mit Mailtrap (optional)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
# MAIL_ENCRYPTION=tls

# Für Produktion (z.B. mit SMTP, SendGrid, Mailgun, etc.)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your_sendgrid_api_key
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="noreply@yourdomain.com"
# MAIL_FROM_NAME="EpiDoc"

# =============================================================================
# Sanctum (API Authentication)
# =============================================================================
# Für Development: localhost und 127.0.0.1 inkludiert
# Für Produktion: Eigene Domain hier eintragen (komma-separiert)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_PREFIX=

# =============================================================================
# CORS Configuration
# =============================================================================
# Für Produktion: Frontend-URLs hier eintragen (komma-separiert)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# AWS S3 (optional, für Datei-Uploads/Video-Upload)
# =============================================================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Redis (optional, für Cache/Queue in Produktion)
# =============================================================================
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

# =============================================================================
# Third-Party Services (optional)
# =============================================================================
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# =============================================================================
# Admin-Zugang
# =============================================================================
# PFLICHT: Sicheres Passwort für den Admin-Bereich (Analytics, Feedback)
# Ohne diesen Wert ist der Admin-Bereich gesperrt!
ADMIN_PASSWORD=

# =============================================================================
# Push Notifications (Web Push / VAPID) - optional
# =============================================================================
# Für Frontend: NEXT_PUBLIC_VAPID_PUBLIC_KEY muss gesetzt werden
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-email@example.com

# =============================================================================
# Logging Services (optional)
# =============================================================================
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=Laravel Log
# LOG_SLACK_EMOJI=:boom:
